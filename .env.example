# ============ rogue agent 自身配置 ============

# rogue agent 大脑 (LLM)，二选一:
# A) Google Gemini: 取消下一行注释并填真实 key, EVAL_GENERATOR_MODEL 用 gemini 系模型
# GOOGLE_API_KEY=
# B) OpenAI 兼容 API (本地调试推荐 DeepSeek): 同时填 ROGUE_LLM_BASE_URL 与 ROGUE_LLM_API_KEY,
#    EVAL_GENERATOR_MODEL 改成对应模型名。两项都填时 B 优先。
#    DeepSeek 可用模型: deepseek-chat / deepseek-reasoner (没有 deepseek-flash!)
#    (DeepSeek key 获取: https://platform.deepseek.com)
ROGUE_LLM_BASE_URL=https://api.deepseek.com/v1
ROGUE_LLM_API_KEY=
EVAL_GENERATOR_MODEL=deepseek-chat

# ============ 日志 ============
# 设为 DEBUG 时, 控制台/CLI 日志会打印每轮问答全文与完整对话 trace
ROGUE_LOG_LEVEL=INFO

# ============ Elasticsearch (可选) ============
# 不配 ES 时测试结果只留在控制台内存里，重启即失
# ES_ENDPOINT=http://localhost:9200
# ES_INDEX_PREFIX=rogue-eval

# ============ 被测 agent ============
# 被测 agent 的 endpoint 与 token 不在这里 —— 属于每次测试的控制台输入:
#   Web 控制台: 表单中填写
#   CLI 调试:   --config 指定 JSON, 或 shell 环境变量 ROGUE_TARGET_ENDPOINT / ROGUE_TARGET_API_TOKEN / ROGUE_TARGET_MODEL
